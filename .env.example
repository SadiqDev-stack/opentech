# ---------- SERVER ----------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api

# ---------- DATABASE ----------
MONGODB_URI=mongodb://127.0.0.1:27017/opentech

# ---------- AUTH ----------
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=opentech_session
COOKIE_SECURE=false

# ---------- ADMIN SEED (created once on first boot) ----------
ADMIN_NAME=Khalifa Aminu Kano
ADMIN_EMAIL=khalifa@opentech.ng
ADMIN_PASSWORD=ChangeThisPassword123!

# ---------- EMAIL (Nodemailer / SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpenTech <no-reply@opentech.ng>

# ---------- PAYSTACK ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- EBULKSMS ----------
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
EBULKSMS_SENDER=OpenTech
